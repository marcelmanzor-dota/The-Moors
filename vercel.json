{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/feed/", "destination": "/feed.xml", "permanent": true },
    { "source": "/es/feed/", "destination": "/es/feed.xml", "permanent": true },
    { "source": "/studio/", "destination": "https://the-moors.sanity.studio/", "permanent": false },
    { "source": "/category/smartaccess-gate-system/", "destination": "/gates-and-security/smartplus-gate-system/", "permanent": true },
    { "source": "/category/associations/village-homes/", "destination": "/about-the-moors/village-homes/", "permanent": true },
    { "source": "/category/associations/patio-homes/", "destination": "/about-the-moors/patio-homes/", "permanent": true },
    { "source": "/sitemap/", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
