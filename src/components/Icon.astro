---
/* Small stroke icon set. All icons are decorative unless a label is passed. */
interface Props { name: string; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;

const paths: Record<string, string> = {
  chevron: '<path d="M2 4l4 4 4-4"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  mail: '<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
  card: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/>',
  id: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16c.6-1.6 1.8-2.4 3.2-2.4s2.6.8 3.2 2.4M14.5 10h3.5M14.5 13.5h3.5"/>',
  gate: '<path d="M4 21V8M20 21V8M4 8c2.5-3 13.5-3 16 0M8 21V9.5M12 21V8.6M16 21V9.5M4 14h16"/>',
  shield: '<path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  rss: '<path d="M5 19a1 1 0 110-.01M5 12a7 7 0 017 7M5 5a14 14 0 0114 14"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.6 5.7 3.6 9s-1.1 6.3-3.6 9c-2.5-2.7-3.6-5.7-3.6-9S9.5 5.7 12 3z"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/>',
  ball: '<circle cx="12" cy="12" r="9"/><path d="M4.5 7.5c3.5 1 5.5 4 5.5 8.5M19.5 16.5c-3.5-1-5.5-4-5.5-8.5"/>',
};
const vb = name === 'chevron' ? '0 0 12 12' : '0 0 24 24';
---
<svg
  class={cls}
  viewBox={vb}
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'chevron' ? 1.8 : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name] ?? ''}
/>
