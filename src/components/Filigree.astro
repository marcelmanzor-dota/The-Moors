---
/*
 * A Victorian gilt frame: four scrollwork corners joined by hairlines.
 * Each stroke uses pathLength="1" so CSS can draw it in with stroke-dashoffset.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
const corners = ['tl', 'tr', 'br', 'bl'];
---
<div class:list={['filigree', cls]} aria-hidden="true">
  {corners.map((c) => (
    <svg class={`filigree__corner filigree__corner--${c}`} viewBox="0 0 140 140" fill="none">
      <path d="M4 136V4h132" pathLength="1" />
      <path d="M14 136V30q0-16 16-16h106" pathLength="1" />
      <path d="M4 4c26 0 42 14 40 34-2 16-18 20-24 10-5-8 2-16 10-14 6 2 6 10 0 10" pathLength="1" />
      <path d="M44 38c16-8 34-8 48-16M60 30c4-8 12-10 20-8" pathLength="1" />
      <path d="M38 44c-8 16-8 34-16 48M30 60c-8 4-10 12-8 20" pathLength="1" />
      <circle cx="104" cy="14" r="2.6" />
      <circle cx="14" cy="104" r="2.6" />
      <path d="M118 8l4 6-4 6-4-6z" pathLength="1" />
      <path d="M8 118l6 4-6 4-6-4z" pathLength="1" />
    </svg>
  ))}
  <span class="filigree__edge filigree__edge--top"></span>
  <span class="filigree__edge filigree__edge--bottom"></span>
  <span class="filigree__edge filigree__edge--left"></span>
  <span class="filigree__edge filigree__edge--right"></span>
</div>
